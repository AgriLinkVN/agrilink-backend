# ============================================================
# AgriLink Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_PORT=3000
NODE_ENV=development

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrilink_db
DB_USER=postgres
DB_PASS=your_password_here
# Set to true in development to sync schema automatically (NEVER use in production)
DB_SYNCHRONIZE=false
# Set to true to log all SQL queries
DB_LOGGING=false

# --- JWT Access Token ---
JWT_SECRET=change_me_to_a_long_random_secret_string
# Examples: 15m, 1h, 7d
JWT_EXPIRES_IN=15m

# --- JWT Refresh Token ---
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret
# Examples: 7d, 30d
JWT_REFRESH_EXPIRES_IN=7d

# --- OTP / SMS (Twilio or similar) ---
OTP_TTL_SECONDS=300
SMS_PROVIDER_API_KEY=your_sms_api_key
SMS_FROM_NUMBER=+84xxxxxxxxx

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@agrilink.vn
SMTP_PASS=your_smtp_password
SMTP_FROM=AgriLink <no-reply@agrilink.vn>

# --- File Storage (S3 or compatible) ---
STORAGE_BUCKET=agrilink-uploads
STORAGE_REGION=ap-southeast-1
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_ENDPOINT=https://s3.amazonaws.com

# --- Redis (for caching / sessions, future use) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- API Rate Limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100
